{{ ansible_managed | comment }}
# VRRP configuration for the Technitium DNS service address.
# Technitium clustering replicates configuration between nodes; this file only
# decides which node currently holds the service address.

global_defs {
    router_id {{ technitium_dns_keepalived_router_id }}
    enable_script_security
    script_user {{ technitium_dns_keepalived_script_user }}
{% for line in technitium_dns_keepalived_global_defs %}
    {{ line }}
{% endfor %}
}

{% if technitium_dns_keepalived_health_check_enabled %}
vrrp_script {{ technitium_dns_keepalived_health_check_name }} {
    script "{{ technitium_dns_keepalived_script_dir }}/check_technitium_dns.sh"
    interval {{ technitium_dns_keepalived_health_check_interval }}
    timeout {{ technitium_dns_keepalived_health_check_timeout }}
    fall {{ technitium_dns_keepalived_health_check_fall }}
    rise {{ technitium_dns_keepalived_health_check_rise }}
{% if technitium_dns_keepalived_health_check_weight | int != 0 %}
    weight {{ technitium_dns_keepalived_health_check_weight }}
{% endif %}
}

{% endif %}
{% for raw_instance in technitium_dns_keepalived_instances %}
{% set instance = technitium_dns_keepalived_instance_defaults | combine(raw_instance) %}
vrrp_instance {{ instance.name }} {
    state {{ instance.state }}
    interface {{ instance.interface }}
    virtual_router_id {{ instance.virtual_router_id }}
    priority {{ instance.priority | default(100) }}
    advert_int {{ instance.advert_int }}
{% if not instance.preempt %}
    nopreempt
{% elif instance.preempt_delay | int > 0 %}
    preempt_delay {{ instance.preempt_delay }}
{% endif %}
{% if instance.garp_master_delay is defined %}
    garp_master_delay {{ instance.garp_master_delay }}
{% endif %}
{% if instance.garp_master_refresh | default(0) | int > 0 %}
    garp_master_refresh {{ instance.garp_master_refresh }}
{% endif %}
{% if instance.version | default(0) | int == 3 %}
    version 3
{% endif %}

{% if instance.unicast %}
    # Unicast VRRP: no multicast needed on the segment, which is the only thing
    # that works on most cloud and routed networks.
    unicast_src_ip {{ instance.unicast_src_ip
                      | default(ansible_default_ipv4.address | default(ansible_host)) }}
    unicast_peer {
{% for peer in instance.unicast_peers | default(technitium_dns_keepalived_default_peers) %}
        {{ peer }}
{% endfor %}
    }

{% endif %}
{% if instance.authentication is defined %}
    authentication {
        auth_type {{ instance.authentication.auth_type | default('PASS') }}
        auth_pass {{ instance.authentication.auth_pass }}
    }

{% endif %}
    virtual_ipaddress {
{% for vip in instance.virtual_ipaddresses %}
        {{ vip.address }}{% if vip.prefix is defined %}/{{ vip.prefix }}{% endif %}
{{- ' dev ' ~ (vip.dev | default(instance.interface)) }}
{%- if vip.label is defined %} label {{ vip.label }}{% endif %}

{% endfor %}
    }
{% if instance.virtual_routes is defined %}

    virtual_routes {
{% for route in instance.virtual_routes %}
        {{ route }}
{% endfor %}
    }
{% endif %}
{% set tracked = instance.track_scripts
                 | default([technitium_dns_keepalived_health_check_name]
                           if technitium_dns_keepalived_health_check_enabled else []) %}
{% if tracked | length > 0 %}

    track_script {
{% for script in tracked %}
        {{ script }}
{% endfor %}
    }
{% endif %}
{% if instance.track_interfaces is defined %}

    track_interface {
{% for iface in instance.track_interfaces %}
        {{ iface }}
{% endfor %}
    }
{% endif %}
{% if technitium_dns_keepalived_notify_enabled %}

    notify "{{ technitium_dns_keepalived_script_dir }}/notify_vrrp.sh"
{% endif %}
}

{% endfor %}
